# Conexión a Postgres (Neon). En Vercel la pone sola la integración de Storage.
DATABASE_URL=postgresql://usuario:contraseña@host/basededatos?sslmode=require

# Clave de cifrado del sorteo. SOLO la conoce IT. 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAIRING_KEY=

# Secreto de las sesiones. 32 bytes en base64 (mismo comando que arriba).
AUTH_SECRET=

# URL pública de la app, sin barra al final (se usa en los enlaces de WhatsApp).
APP_URL=https://amigoinvisible.quickgold.es

# Teléfonos de las administradoras (separados por coma, con o sin prefijo).
# El login no usa email: es un enlace personal por WhatsApp para todo el mundo.
ADMIN_PHONES=34684114286

# WhatsApp Business Cloud API (Meta). El token de acceso temporal del panel
# caduca en 24h; para producción hace falta uno permanente (usuario del
# sistema). Sin estas dos, los envíos de /admin fallan con un error claro.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Resend (solo para el aviso excepcional de "reparar cadena"). Si se deja
# vacío, ese aviso se imprime por consola en vez de enviarse.
RESEND_API_KEY=
RESEND_FROM="El Empeño Invisible <no-reply@quickgold.es>"

# PIN de la pantalla de la cena
DINNER_PIN=4582

# Fechas del calendario (ISO, hora de Europe/Madrid). Ver sección 1 de la spec.
DATE_SORTEO=2026-11-09T09:00:00+01:00
DATE_FICHA_1=2026-11-16T09:00:00+01:00
DATE_FICHA_2=2026-11-23T09:00:00+01:00
DATE_FICHA_3=2026-11-30T09:00:00+01:00
DATE_ENTREGA=2026-12-02T00:00:00+01:00
DATE_CIERRE_RESENAS=2026-12-10T23:59:00+01:00
DATE_CENA=2026-12-11T00:00:00+01:00
